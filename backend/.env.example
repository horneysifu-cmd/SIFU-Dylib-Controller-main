# Required: generate a long random secret; never commit the real value.
ADMIN_TOKEN=replace-with-a-long-random-secret
DATABASE_PATH=./data/sifu_licenses.db

# Comma-separated exact dashboard origins. Leave empty only for same-origin deployments.
ALLOWED_ORIGINS=http://localhost:8000

# Per-IP limit for public license activation/validation endpoints.
RATE_LIMIT_PER_MINUTE=30

# Enable interactive API docs only for development.
ENABLE_DOCS=false
