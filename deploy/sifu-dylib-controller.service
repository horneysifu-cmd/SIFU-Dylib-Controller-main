[Unit]
Description=SIFU Dylib Controller API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sifu-dylib-controller/backend
EnvironmentFile=/etc/sifu-dylib-controller.env
ExecStart=/opt/sifu-dylib-controller/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8765 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/sifu-dylib-controller

[Install]
WantedBy=multi-user.target
